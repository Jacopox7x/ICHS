{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iCrawler",
  "version": "3.8.0",
  "identifier": "com.icrawler.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "iCrawler",
        "width": 1200,
        "height": 800,
        "url": "http://localhost:8080"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:8080; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}