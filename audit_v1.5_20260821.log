=== 9. CONTENUTO ICRAWLER_SIMPLE.PY (prime 60 righe) ===
#!/usr/bin/env python3
import sys
import ollama
from config import config
from prompt_builder import PromptBuilder
from topics import TopicExtractor
from hashtags import HashtagEngine
from utils import setup_logging, save_output
from validator import Validator

logger = setup_logging()

class ICrawler:
    def __init__(self):
        self.model = config.get("OLLAMA_MODEL", "phi3.5:3.8b-mini-instruct-q4_K_M")
        self.prompt_builder = PromptBuilder()
        self.topic_extractor = TopicExtractor()
        self.hashtag_engine = HashtagEngine()
        self.platforms = ["Instagram", "Twitter", "Facebook", "TikTok"]
        self.validator = Validator()
    
    def generate_strategy(self, brief: str, brief_data: dict = None) -> str:
        if not brief or not brief.strip():
            return "⚠️ Inserisci un brief valido."
        
        topic = self.topic_extractor.extract(brief)
        hashtag_pool = self.hashtag_engine.generate_pool_for_prompt(topic.main_topic, topic.category)
        prompt = self.prompt_builder.build(brief, topic, hashtag_pool, self.platforms)
        
        print("\n🔄 Generazione in corso...")
        
        try:
            response = ollama.chat(
                model=self.model,
                messages=[{"role": "user", "content": prompt}],
                options={"temperature": config.get("TEMPERATURE", 0.7), "num_predict": config.get("MAX_TOKENS", 4096)}
            )
            output = response["message"]["content"]
            
            if brief_data:
                print("🔍 Controllo qualità in corso...")
                result = self.validator.validate(output, brief_data)
                if not result["valid"]:
                    print("⚠️ Il piano presenta alcune irregolarità. Rigenerazione in corso...")
                    response = ollama.chat(
                        model=self.model,
                        messages=[{"role": "user", "content": prompt}],
                        options={"temperature": 0.3, "num_predict": config.get("MAX_TOKENS", 4096)}
                    )
                    output = response["message"]["content"]
                    result = self.validator.validate(output, brief_data)
                    if not result["valid"]:
                        print("❌ Il piano non supera i controlli di qualità. Ecco gli errori:")
                        for error in result["errors"]:
                            print(f"  - {error}")
                        return f"❌ Validazione fallita:\n" + "\n".join(result["errors"])
            
            save_output(brief, output, topic.category)
            print("✅ Piano validato!")
            return output

