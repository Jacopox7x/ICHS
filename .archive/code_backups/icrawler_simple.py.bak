#!/usr/bin/env python3
import sys
import subprocess
import time
import os
import shutil
import threading
import ollama
from config import config
from prompt_builder import PromptBuilder
from topics import TopicExtractor
from hashtags import HashtagEngine
from utils import setup_logging, save_output

logger = setup_logging()

def start_ollama_background():
    """Avvia Ollama in background SENZA attendere."""
    try:
        # Verifica se Ollama è già in esecuzione
        result = subprocess.run(["pgrep", "-x", "ollama"], capture_output=True, text=True)
        if result.returncode == 0 and result.stdout.strip():
            print("✅ Ollama già in esecuzione")
            return True
        
        # Percorso di Ollama
        ollama_path = shutil.which("ollama") or "/usr/local/bin/ollama"
        
        # Avvia Ollama in background
        print("🔄 Avvio Ollama in background...")
        subprocess.Popen(
            [ollama_path, "serve"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            stdin=subprocess.DEVNULL
        )
        print("✅ Ollama avviato in background")
        return True
    except Exception as e:
        print(f"⚠️ Errore avvio Ollama: {e}")
        return False

class ICrawler:
    def __init__(self):
        self.model = config.get("OLLAMA_MODEL", "phi3.5:3.8b-mini-instruct-q4_K_M")
        self.prompt_builder = PromptBuilder()
        self.topic_extractor = TopicExtractor()
        self.hashtag_engine = HashtagEngine()
        self.platforms = ["Instagram", "Twitter", "Facebook", "TikTok"]
    
    def generate_strategy(self, brief: str) -> str:
        if not brief or not brief.strip():
            return "⚠️ Inserisci un brief valido."
        
        topic = self.topic_extractor.extract(brief)
        hashtag_pool = self.hashtag_engine.generate_pool_for_prompt(topic.main_topic, topic.category)
        prompt = self.prompt_builder.build(brief, topic, hashtag_pool, self.platforms)
        
        print("\n🔄 Generazione in corso...")
        
        try:
            response = ollama.chat(
                model=self.model,
                messages=[{"role": "user", "content": prompt}],
                options={"temperature": config.get("TEMPERATURE", 0.7), "num_predict": config.get("MAX_TOKENS", 4096)}
            )
            output = response["message"]["content"]
            save_output(brief, output, topic.category)
            return output
        except Exception as e:
            logger.error(f"Errore: {e}")
            return f"❌ Errore: {str(e)}"

def main():
    print("🕷️ iCrawler - Social Media Strategist AI")
    print("=" * 60)
    
    # Avvia Ollama in background SENZA attendere
    start_ollama_background()
    
    print("=" * 60)
    print("Piattaforme: Instagram, Twitter, Facebook, TikTok")
    print("Inserisci il brief (premi Invio due volte per generare):")
    print("=" * 60)
    
    lines = []
    while True:
        try:
            line = input()
            if line == "":
                break
            lines.append(line)
        except EOFError:
            break
    
    brief = "\n".join(lines).strip()
    if not brief:
        print("❌ Nessun brief inserito.")
        return
    
    crawler = ICrawler()
    result = crawler.generate_strategy(brief)
    
    print("\n" + "=" * 60)
    print("📊 PIANO SOCIAL GENERATO")
    print("=" * 60)
    print(result)
    print("\n" + "=" * 60)

if __name__ == "__main__":
    main()
