from pathlib import Path
import config


class PromptBuilder:
    def __init__(self):
        self.prompt_file = Path(config.PROMPT_DIR) / "strategist.txt"

    def build(self, brief: str, topic, hashtag_pool: list, platforms: list = None) -> str:
        if self.prompt_file.exists():
            with open(self.prompt_file, "r", encoding="utf-8") as f:
                system_prompt = f.read()
        else:
            system_prompt = "Sei uno strategist social media. Scrivi un piano social."

        platforms_text = ", ".join(platforms) if platforms else "Instagram"

        return f"""{system_prompt}

## BRIEF DELL'EVENTO

{brief}

## PIATTAFORME DA UTILIZZARE

{platforms_text}

## HASHTAG DISPONIBILI

{", ".join(hashtag_pool[:7])}

## ISTRUZIONE FINALE

Rispetta rigorosamente il brief.
Non inventare fatti.
Genera contenuti solo per le piattaforme indicate.
"""


