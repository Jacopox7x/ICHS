# ============================================
# iCrawler — Configurazione Cognee
# ============================================
# Copia questo file in `.env` e modifica i valori.
# Nota: Ollama, GLiNER, SearXNG e UI port sono
# attualmente hardcoded. Vedi README.
# ============================================

# --- LLM provider (usato da cognee_ingest.py) ---
# Per Ollama (locale), LLM_API_KEY è ignorata ma DEVE essere presente
# per via della validazione di coerenza di Cognee (richiede tutte e 3).
LLM_PROVIDER=ollama
LLM_MODEL=phi3.5-fixed
LLM_ENDPOINT=http://localhost:11434
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.0

# --- Embedding provider ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
EMBEDDING_DIMENSIONS=768

# --- Path documenti ---
DOCUMENTS_PATH=./accademia_material

# --- Cognee behavior (opzionali, default sensati) ---
# Disabilita caching sessione Cognee (default: true)
CACHING=true
# Disabilita access control multi-tenant (default: true)
ENABLE_BACKEND_ACCESS_CONTROL=false
# Tokenizer HuggingFace (default: usa quello del modello)
# HUGGINGFACE_TOKENIZER=
