from pathlib import Path
import config
from hashtag_cloud import HashtagCloud
from hashtag_suggester import HashtagSuggester

class PromptBuilder:
    def __init__(self):
        self.prompt_file = Path(config.PROMPT_DIR) / "strategist.txt"
        self.hashtag_cloud = HashtagCloud()
        self.suggester = HashtagSuggester()
    
    def build(self, brief: str, topic, hashtag_pool: list, platforms: list = None, entities: dict = None) -> str:
        if self.prompt_file.exists():
            with open(self.prompt_file, 'r', encoding='utf-8') as f:
                system_prompt = f.read()
        else:
            system_prompt = "Sei uno strategist social media. Crea un piano social in JSON."

        # Se abbiamo entita estratte da GLiNER, le usiamo come fonte primaria.
        # Altrimenti fallback sul parsing tradizionale riga per riga.
        if entities:
            brief_data = {
                "nome_evento": entities.get("event", ""),
                "data": entities.get("date", ""),
                "luogo": entities.get("location", ""),
                "target": entities.get("target audience", ""),
                "hashtag": entities.get("hashtag", ""),
                "descrizione": entities.get("topic", ""),
                "budget": entities.get("budget", ""),
            }
            # Rimuovi le chiavi vuote cosi il prompt non ha campi vuoti
            brief_data = {k: v for k, v in brief_data.items() if v}
        else:
            brief_data = {}
            for line in brief.split('\n'):
                if ":" in line:
                    key, value = line.split(":", 1)
                    key = key.strip().lower()
                    value = value.strip()
                    if "evento" in key or "nome" in key:
                        brief_data["nome_evento"] = value
                    elif "data" in key:
                        brief_data["data"] = value
                    elif "luogo" in key:
                        brief_data["luogo"] = value
                    elif "target" in key:
                        brief_data["target"] = value
                    elif "hashtag" in key:
                        brief_data["hashtag"] = value
                    elif "descrizione" in key:
                        brief_data["descrizione"] = value

        # Ottieni hashtag dal cloud (fallback)
        cloud_hashtags = self.hashtag_cloud.get_hashtags(topic.category, topic.main_topic)

        # Genera suggerimenti hashtag dal brief
        suggestions = self.suggester.suggest(brief_data, count=8)

        # Costruisci una lista di hashtag consigliati (suggerimenti + cloud)
        if suggestions:
            suggested_str = ", ".join(suggestions)
        else:
            suggested_str = "Nessun suggerimento disponibile"

        # Aggiungi al prompt anche le entita estratte, se presenti,
        # cosi il modello le ha sempre sotto gli occhi
        entities_block = ""
        if entities:
            lines = ["\n--- ENTITA ESTRATTE DAL BRIEF ---"]
            for k, v in entities.items():
                lines.append(f"{k}: {v}")
            lines.append("--- FINE ENTITA ---\n")
            entities_block = "\n".join(lines)

        # Sostituisci nel prompt
        prompt = system_prompt.replace("{brief}", brief)
        prompt = prompt.replace("{hashtag_suggestions}", suggested_str)
        prompt = prompt.replace("{cloud_hashtags}", ", ".join(cloud_hashtags[:10]))

        # Se il template ha un placeholder per le entita, sostituiscilo.
        # Altrimenti aggiungi il blocco in fondo al prompt.
        if "{entities}" in prompt:
            prompt = prompt.replace("{entities}", entities_block)
        elif entities_block:
            prompt = prompt + entities_block

        return prompt
